def get_eval_result(test_df, predictions, label="label"):
    y_pred = test_df[predictions].tolist()
    y_test = test_df[label].tolist()

    FN, FP, TN, TP, accuracy, f1, precision, recall = calculate_results(y_pred, y_test)

    return FN, FP, TN, TP, accuracy, f1, precision, recall

